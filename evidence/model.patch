+{% extends "ui/panels/_base.html" %}
+{% load helpers %}
+{% load i18n %}
+
+{% block panel_content %}
+  {% if secrets %}
+    <table class="table table-hover">
+      <thead>
+        <tr>
+          <th>{% trans "Key ID" %}</th>
+          <th>{% trans "Status" %}</th>
+          <th>{% trans "Primary" %}</th>
+          <th>{% trans "Secret" %}</th>
+        </tr>
+      </thead>
+      <tbody>
+        {% for secret in secrets %}
+          <tr>
+            <td class="font-monospace">{{ secret.key_id }}</td>
+            <td>
+              {% if secret.status_color %}
+                {% badge secret.status_label bg_color=secret.status_color %}
+              {% else %}
+                {{ secret.status_label }}
+              {% endif %}
+            </td>
+            <td>
+              {% if secret.is_primary %}
+                {% checkmark True %}
+              {% else %}
+                {{ ''|placeholder }}
+              {% endif %}
+            </td>
+            <td class="font-monospace text-truncate" style="max-width: 280px;">{{ secret.secret }}</td>
+          </tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  {% else %}
+    <div class="list-group-item text-muted">
+      {% trans "No signing secrets configured; requests are sent without signature headers." %}
+    </div>
+  {% endif %}
+{% endblock panel_content %}
