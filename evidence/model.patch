+<table class="table table-hover table-sm">
+  <thead>
+    <tr>
+      <th class="w-5">Primary</th>
+      <th class="w-25">Key ID</th>
+      <th class="w-30">Secret</th>
+      <th class="w-20">Status</th>
+      <th class="w-5 text-end">Delete</th>
+    </tr>
+  </thead>
+  <tbody>
+    {% for row in widget.rows %}
+      <tr {% if row.retired %}class="table-secondary"{% endif %}>
+        <td class="align-middle">
+          <div class="form-check mb-0">
+            <input
+              type="radio"
+              class="form-check-input"
+              name="{{ widget.name }}_primary"
+              value="{{ row.index }}"
+              id="{{ widget.name }}_primary_{{ row.index }}"
+              {% if row.is_primary %}checked{% endif %}
+              {% if row.retired %}disabled{% endif %}
+            />
+          </div>
+        </td>
+        <td>
+          <input
+            type="text"
+            class="form-control font-monospace{% if row.retired %} bg-light{% endif %}"
+            name="{{ widget.name }}_key_id"
+            value="{{ row.key_id }}"
+            maxlength="100"
+            {% if row.retired %}readonly{% endif %}
+          />
+        </td>
+        <td>
+          <input
+            type="text"
+            class="form-control font-monospace{% if row.retired %} bg-light{% endif %}"
+            name="{{ widget.name }}_secret"
+            value="{{ row.secret }}"
+            maxlength="255"
+            {% if row.retired %}readonly{% endif %}
+          />
+        </td>
+        <td>
+          {% if row.retired %}
+            <span class="badge text-bg-danger">Retired</span>
+            <input type="hidden" name="{{ widget.name }}_status" value="retired" />
+          {% else %}
+            <select class="form-select" name="{{ widget.name }}_status">
+              {% for value, label in row.status_choices %}
+                <option value="{{ value }}"{% if value == row.status %} selected{% endif %}>{{ label }}</option>
+              {% endfor %}
+            </select>
+          {% endif %}
+        </td>
+        <td class="align-middle text-end">
+          {% if not row.blank %}
+            <div class="form-check mb-0 d-inline-block">
+              <input
+                type="checkbox"
+                class="form-check-input"
+                name="{{ widget.name }}_delete"
+                value="{{ row.key_id }}"
+                id="{{ widget.name }}_delete_{{ row.index }}"
+              />
+            </div>
+          {% endif %}
+        </td>
+      </tr>
+    {% endfor %}
+  </tbody>
+</table>
+<p class="text-muted small mb-0">
+  Key IDs may contain only letters, numbers, hyphens, and underscores. Every webhook with secrets must have exactly
+  one enabled <strong>primary</strong> secret, which also signs the legacy <code>X-Hook-Signature</code> header; all
+  enabled secrets appear in the <code>X-Hook-Signatures</code> header. Retired secrets never sign new events and
+  cannot be modified, but remain listed until deleted.
+</p>
